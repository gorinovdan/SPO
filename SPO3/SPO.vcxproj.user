<?xml version="1.0" encoding="utf-8"?>
<Project ToolsVersion="Current" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Debug|x64'">
    <RemoteDebuggerCommand>$(RemoteBuildOutputs)</RemoteDebuggerCommand>
    <DebuggerFlavor>LinuxDebugger</DebuggerFlavor>
    <RemoteDebuggerCommandArguments>/home/user/projects/SystemSoftware/content/in.txt /home/user/projects/SystemSoftware/content/math.txt /home/user/projects/SystemSoftware/test</RemoteDebuggerCommandArguments>
    <RemoteDebuggerCommandArgumentsHistory>/home/user/projects/SystemSoftware/content/in.txt /home/user/projects/SystemSoftware/content/math.txt /home/user/projects/SystemSoftware/test|</RemoteDebuggerCommandArgumentsHistory>
  </PropertyGroup>
  <PropertyGroup>
    <ShowAllFiles>true</ShowAllFiles>
  </PropertyGroup>
</Project>