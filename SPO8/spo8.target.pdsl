architecture vm32 {

    registers:

        // Видимые регистры процессора.
        storage ip_s[32];
        storage sp_s[32];
        storage bp_s[32];
        storage io_s[32];

        view ip = ip_s;
        view sp = sp_s;
        view bp = bp_s;
        view io = io_s;

        // Состояние времени выполнения, инициализируется загрузчиком.
        storage dbp_s[32];
        storage df_size_s[32];
        storage csp_s[32];

        view dbp = dbp_s;
        view df_size = df_size_s;
        view csp = csp_s;

        // Защёлки ввода-вывода для базовых инструкций IN/OUT.
        storage rin_s[32];
        storage rout_s[32];

        view rin = rin_s;
        view rout = rout_s;

        // Сохранённый контекст прерывания: sp/bp/dbp/csp сохраняются программно.
        // irq_ip хранится в pic_state:4[0] (InterruptedInstructionAddress), его задаёт PIC.
        storage irq_sp_s[32];
        storage irq_bp_s[32];
        storage irq_dbp_s[32];
        storage irq_csp_s[32];

        view irq_sp = irq_sp_s;
        view irq_bp = irq_bp_s;
        view irq_dbp = irq_dbp_s;
        view irq_csp = irq_csp_s;

        // Отдельный контекст ядра, используемый при входе в прерывание таймера.
        storage ksp_s[32];
        storage kbp_s[32];
        storage kdbp_s[32];
        storage kcsp_s[32];

        view ksp = ksp_s;
        view kbp = kbp_s;
        view kdbp = kdbp_s;
        view kcsp = kcsp_s;

        // sp/bp/csp являются байтовыми смещениями; размер машинного слова равен 4.

    memory:

        range code [0x00000000 .. 0xffffffff] {
            cell = 8;
            endianess = little-endian;
            granularity = 0;
        }

        range const_pool [0x00000000 .. 0xffffffff] {
            cell = 8;
            endianess = little-endian;
            granularity = 0;
        }

        range data_mem [0x00000000 .. 0xffffffff] {
            cell = 8;
            endianess = little-endian;
            granularity = 0;
        }

        // data_meta[addr] хранит размер элемента в байтах; 0 означает размер слова.
        range data_meta [0x00000000 .. 0xffffffff] {
            cell = 8;
            endianess = little-endian;
            granularity = 0;
        }

        range stack_mem [0x00000000 .. 0xffffffff] {
            cell = 8;
            endianess = little-endian;
            granularity = 0;
        }

        // Кадры вызовов: [return_ip, bp, dbp], упакованные словами.
        range call_stack [0x00000000 .. 0xffffffff] {
            cell = 8;
            endianess = little-endian;
            granularity = 0;
        }

        // Внешний банк состояния SimplePic: InterruptedInstructionAddress, InterruptsAllowed и т. д.
        range pic_state [0x00000000 .. 0x00000030] {
            cell = 8;
            endianess = little-endian;
            granularity = 0;
        }

        // Внешняя таблица обработчиков SimplePic; запись k по смещению k*4 хранит ip обработчика.
        range pic_handlers [0x00000000 .. 0x00000100] {
            cell = 8;
            endianess = little-endian;
            granularity = 0;
        }

        // Внешний банк состояния SimpleClock: Ticks, Cycles, CyclesSignalPeriod и т. д.
        range clock_state [0x00000000 .. 0x00000048] {
            cell = 8;
            endianess = little-endian;
            granularity = 0;
        }

        // Внешний SimplePipe из devices.xml. Через него RemoteTasks передаёт
        // байтовый поток FTP-команд и ответов.
        range pipe_control [0x00000000 .. 0x00000048] {
            cell = 8;
            endianess = little-endian;
            granularity = 0;
        }

        range pipe_inbox [0x00000000 .. 0x00000800] {
            cell = 8;
            endianess = little-endian;
            granularity = 0;
        }

        range pipe_outbox [0x00000000 .. 0x00000800] {
            cell = 8;
            endianess = little-endian;
            granularity = 0;
        }

        // Пассивный канал данных FTP. В режиме FileZilla файл devices_filezilla.xml
        // связывает его с локальным FTP-адаптером; адаптер открывает PASV-порт
        // и закрывает сокет после каждой передачи для настоящих FTP-клиентов.
        range data_pipe_control [0x00000000 .. 0x00000048] {
            cell = 8;
            endianess = little-endian;
            granularity = 0;
        }

        range data_pipe_inbox [0x00000000 .. 0x00000800] {
            cell = 8;
            endianess = little-endian;
            granularity = 0;
        }

        range data_pipe_outbox [0x00000000 .. 0x00000800] {
            cell = 8;
            endianess = little-endian;
            granularity = 0;
        }

        // Внешний BlockDevice из devices.xml. Это путь BackDevice в RemoteTasks
        // для чтения и записи образа.
        range block_control [0x00000000 .. 0x00000024] {
            cell = 8;
            endianess = little-endian;
            granularity = 0;
        }

        range block_buffer [0x00000000 .. 0x00001000] {
            cell = 8;
            endianess = little-endian;
            granularity = 0;
        }

        range block_error [0x00000000 .. 0x00000400] {
            cell = 8;
            endianess = little-endian;
            granularity = 0;
        }

    instructions:

        encode imm32 field = immediate[32];
        encode code32 field = immediate[32] offset;
        encode data32 field = immediate[32] data;
        encode const32 field = immediate[32] data;

        instruction nop = { 0000 0000 } {
            ip = ip + 1;
        };

        // Перемещение данных и константы.
        // const_id является байтовым адресом в const_pool.
        instruction push-const = { 0000 0001, const32 as const_id } {
            let value = const_pool:4[const_id];
            stack_mem:4[sp] = value;
            sp = sp + 4;
            ip = ip + 5;
        };

        instruction push-addr = { 0000 0010, data32 as addr } {
            let abs_addr = dbp + addr;
            stack_mem:4[sp] = abs_addr;
            sp = sp + 4;
            ip = ip + 5;
        };

        instruction push-code = { 0010 0111, code32 as target } {
            stack_mem:4[sp] = target;
            sp = sp + 4;
            ip = ip + 5;
        };

        instruction load = { 0000 0011, data32 as addr } {
            let abs_addr = dbp + addr;
            let size = data_meta:4[addr];
            if size == 1 then
                stack_mem:4[sp] = data_mem:1[abs_addr];
            else
                stack_mem:4[sp] = data_mem:4[abs_addr];
            sp = sp + 4;
            ip = ip + 5;
        };

        instruction store = { 0000 0100, data32 as addr } {
            sp = sp - 4;
            let value = stack_mem:4[sp];
            let abs_addr = dbp + addr;
            let size = data_meta:4[addr];
            if size == 1 then
                data_mem:1[abs_addr] = value;
            else
                data_mem:4[abs_addr] = value;
            ip = ip + 5;
        };

        instruction load-ind = { 0000 0101 } {
            sp = sp - 4;
            let addr = stack_mem:4[sp];
            let value = data_mem:4[addr];
            stack_mem:4[sp] = value;
            sp = sp + 4;
            ip = ip + 1;
        };

        instruction store-ind = { 0000 0110 } {
            sp = sp - 4;
            let value = stack_mem:4[sp];
            sp = sp - 4;
            let addr = stack_mem:4[sp];
            data_mem:4[addr] = value;
            ip = ip + 1;
        };

        instruction pop = { 0000 0111 } {
            sp = sp - 4;
            ip = ip + 1;
        };

        // Арифметика и логика.
        // Среда выполнения склеивает строки, если хотя бы один операнд является строкой.
        instruction add = { 0000 1000 } {
            sp = sp - 4;
            let b = stack_mem:4[sp];
            sp = sp - 4;
            let a = stack_mem:4[sp];
            stack_mem:4[sp] = a + b;
            sp = sp + 4;
            ip = ip + 1;
        };

        instruction sub = { 0000 1001 } {
            sp = sp - 4;
            let b = stack_mem:4[sp];
            sp = sp - 4;
            let a = stack_mem:4[sp];
            stack_mem:4[sp] = a - b;
            sp = sp + 4;
            ip = ip + 1;
        };

        instruction mul = { 0000 1010 } {
            sp = sp - 4;
            let b = stack_mem:4[sp];
            sp = sp - 4;
            let a = stack_mem:4[sp];
            stack_mem:4[sp] = a * b;
            sp = sp + 4;
            ip = ip + 1;
        };

        instruction div = { 0000 1011 } {
            sp = sp - 4;
            let b = stack_mem:4[sp];
            sp = sp - 4;
            let a = stack_mem:4[sp];
            stack_mem:4[sp] = a / b;
            sp = sp + 4;
            ip = ip + 1;
        };

        instruction rem = { 0000 1100 } {
            sp = sp - 4;
            let b = stack_mem:4[sp];
            sp = sp - 4;
            let a = stack_mem:4[sp];
            stack_mem:4[sp] = a % b;
            sp = sp + 4;
            ip = ip + 1;
        };

        instruction neg = { 0000 1101 } {
            sp = sp - 4;
            let a = stack_mem:4[sp];
            stack_mem:4[sp] = 0 - a;
            sp = sp + 4;
            ip = ip + 1;
        };

        instruction and-op = { 0000 1110 } {
            sp = sp - 4;
            let b = stack_mem:4[sp];
            sp = sp - 4;
            let a = stack_mem:4[sp];
            let res = 0;
            if a != 0 && b != 0 then
                res = 1;
            stack_mem:4[sp] = res;
            sp = sp + 4;
            ip = ip + 1;
        };

        instruction or-op = { 0000 1111 } {
            sp = sp - 4;
            let b = stack_mem:4[sp];
            sp = sp - 4;
            let a = stack_mem:4[sp];
            let res = 0;
            if a != 0 || b != 0 then
                res = 1;
            stack_mem:4[sp] = res;
            sp = sp + 4;
            ip = ip + 1;
        };

        instruction lt = { 0001 0000 } {
            sp = sp - 4;
            let b = stack_mem:4[sp];
            sp = sp - 4;
            let a = stack_mem:4[sp];
            let res = 0;
            if a < b then
                res = 1;
            stack_mem:4[sp] = res;
            sp = sp + 4;
            ip = ip + 1;
        };

        instruction gt = { 0001 0001 } {
            sp = sp - 4;
            let b = stack_mem:4[sp];
            sp = sp - 4;
            let a = stack_mem:4[sp];
            let res = 0;
            if a > b then
                res = 1;
            stack_mem:4[sp] = res;
            sp = sp + 4;
            ip = ip + 1;
        };

        instruction le = { 0001 0010 } {
            sp = sp - 4;
            let b = stack_mem:4[sp];
            sp = sp - 4;
            let a = stack_mem:4[sp];
            let res = 0;
            if a <= b then
                res = 1;
            stack_mem:4[sp] = res;
            sp = sp + 4;
            ip = ip + 1;
        };

        instruction ge = { 0001 0011 } {
            sp = sp - 4;
            let b = stack_mem:4[sp];
            sp = sp - 4;
            let a = stack_mem:4[sp];
            let res = 0;
            if a >= b then
                res = 1;
            stack_mem:4[sp] = res;
            sp = sp + 4;
            ip = ip + 1;
        };

        instruction eq = { 0001 0100 } {
            sp = sp - 4;
            let b = stack_mem:4[sp];
            sp = sp - 4;
            let a = stack_mem:4[sp];
            let res = 0;
            if a == b then
                res = 1;
            stack_mem:4[sp] = res;
            sp = sp + 4;
            ip = ip + 1;
        };

        instruction ne = { 0001 0101 } {
            sp = sp - 4;
            let b = stack_mem:4[sp];
            sp = sp - 4;
            let a = stack_mem:4[sp];
            let res = 0;
            if a != b then
                res = 1;
            stack_mem:4[sp] = res;
            sp = sp + 4;
            ip = ip + 1;
        };

        // Управление потоком исполнения.
        instruction jmp = { 0001 0110, code32 as target } {
            ip = target;
        };

        instruction jz = { 0001 0111, code32 as target } {
            sp = sp - 4;
            let value = stack_mem:4[sp];
            if value == 0 then
                ip = target;
            else
                ip = ip + 5;
        };

        // Отрицательные адреса вызовов считаются встроенными операциями print/printf/read.
        instruction call = { 0001 1000, imm32 as target, imm32 as argc } {
            if target < 0 then {
                let i = 0;
                while i < argc do {
                    sp = sp - 4;
                    i = i + 1;
                }
                stack_mem:4[sp] = 0;
                sp = sp + 4;
                ip = ip + 9;
            }
            else {
                call_stack:4[csp] = ip + 9;
                csp = csp + 4;
                call_stack:4[csp] = bp;
                csp = csp + 4;
                call_stack:4[csp] = dbp;
                csp = csp + 4;
                dbp = dbp + df_size;
                ip = target;
            }
        };

        instruction ret = { 0001 1001 } {
            if csp == 0 then
                ip = 0xffffffff;
            else {
                csp = csp - 4;
                dbp = call_stack:4[csp];
                csp = csp - 4;
                bp = call_stack:4[csp];
                csp = csp - 4;
                ip = call_stack:4[csp];
            }
        };

        instruction retf = { 0010 0001 } {
            if csp == 0 then
                ip = 0xffffffff;
            else {
                csp = csp - 4;
                dbp = call_stack:4[csp];
                csp = csp - 4;
                bp = call_stack:4[csp];
                csp = csp - 4;
                ip = call_stack:4[csp];
            }
        };

        instruction enter = { 0001 1010, imm32 as nlocals } {
            bp = sp;
            ip = ip + 5;
        };

        instruction leave = { 0001 1011 } {
            let ret_val = 0;
            if sp > bp then {
                sp = sp - 4;
                ret_val = stack_mem:4[sp];
            }
            sp = bp;
            stack_mem:4[sp] = ret_val;
            sp = sp + 4;
            if csp >= 12 then
                dbp = call_stack:4[csp - 4];
            ip = ip + 1;
        };

        // Индексация.
        instruction range-op = { 0001 1100 } {
            sp = sp - 4;
            let end = stack_mem:4[sp];
            sp = sp - 4;
            let start = stack_mem:4[sp];
            stack_mem:4[sp] = start;
            sp = sp + 4;
            ip = ip + 1;
        };

        instruction index-op = { 0001 1101 } {
            sp = sp - 4;
            let idx = stack_mem:4[sp];
            sp = sp - 4;
            let base = stack_mem:4[sp];
            let addr = base + idx * 4;
            stack_mem:4[sp] = addr;
            sp = sp + 4;
            ip = ip + 1;
        };

        // Ввод-вывод.
        instruction set-port = { 0001 1110 } {
            sp = sp - 4;
            io = stack_mem:4[sp];
            ip = ip + 1;
        };

        instruction in-op = { 0001 1111 } {
            let value = 0;
            if io == 0 then
                value = rin;
            stack_mem:4[sp] = value;
            sp = sp + 4;
            ip = ip + 1;
        };

        instruction out-op = { 0010 0000 } {
            sp = sp - 4;
            let value = stack_mem:4[sp];
            if io == 1 then
                rout = value;
            ip = ip + 1;
        };

        // Системное управление.
        // Схема sys_id. Слоты timer/quantum/intvec/intr_enabled/intr_active удалены:
        // они относились только к локальной эмуляции; таймер теперь живёт в SimpleClock,
        // а флаг разрешения прерываний — в PIC.
        //  5 irq_ip   (псевдоним для pic_state:4[0] = InterruptedInstructionAddress)
        //  6 irq_sp, 7 irq_bp, 8 irq_dbp, 9 irq_csp
        // 10 ksp,   11 kbp,  12 kdbp,    13 kcsp
        // 14 ip,    15 sp,   16 bp,      17 dbp,  18 csp, 19 df_size
        instruction push-sys = { 0010 0010, imm32 as sys_id } {
            let value = 0;
            if sys_id == 5 then
                value = pic_state:4[0];
            else if sys_id == 6 then
                value = irq_sp;
            else if sys_id == 7 then
                value = irq_bp;
            else if sys_id == 8 then
                value = irq_dbp;
            else if sys_id == 9 then
                value = irq_csp;
            else if sys_id == 10 then
                value = ksp;
            else if sys_id == 11 then
                value = kbp;
            else if sys_id == 12 then
                value = kdbp;
            else if sys_id == 13 then
                value = kcsp;
            else if sys_id == 14 then
                value = ip;
            else if sys_id == 15 then
                value = sp;
            else if sys_id == 16 then
                value = bp;
            else if sys_id == 17 then
                value = dbp;
            else if sys_id == 18 then
                value = csp;
            else if sys_id == 19 then
                value = df_size;
            stack_mem:4[sp] = value;
            sp = sp + 4;
            ip = ip + 5;
        };

        instruction pop-sys = { 0010 0011, imm32 as sys_id } {
            sp = sp - 4;
            let value = stack_mem:4[sp];
            if sys_id == 5 then
                pic_state:4[0] = value;
            else if sys_id == 6 then
                irq_sp = value;
            else if sys_id == 7 then
                irq_bp = value;
            else if sys_id == 8 then
                irq_dbp = value;
            else if sys_id == 9 then
                irq_csp = value;
            else if sys_id == 10 then
                ksp = value;
            else if sys_id == 11 then
                kbp = value;
            else if sys_id == 12 then
                kdbp = value;
            else if sys_id == 13 then
                kcsp = value;
            else if sys_id == 19 then
                df_size = value;
            ip = ip + 5;
        };

        // ei/di переключают флаг PIC InterruptsAllowed (pic_state:4[12]).
        instruction ei-op = { 0010 0100 } {
            pic_state:4[12] = 1;
            ip = ip + 1;
        };

        instruction di-op = { 0010 0101 } {
            pic_state:4[12] = 0;
            ip = ip + 1;
        };

        // IRET восстанавливает регистры пользовательского контекста, сохранённые irq-enter,
        // загружает ip из PIC InterruptedInstructionAddress и снова разрешает прерывания.
        instruction iret-op = { 0010 0110 } {
            sp = irq_sp;
            bp = irq_bp;
            dbp = irq_dbp;
            csp = irq_csp;
            ip = pic_state:4[0];
            if clock_state:4[64] == 0 then
                pic_state:4[12] = 0;
            else
                pic_state:4[12] = 1;
        };

        // Трамплин входа в IRQ: атомарно сохраняет пользовательский контекст в irq_*
        // и переключает CPU на регистры ядра sp/bp/dbp/csp. PIC уже сохранил пользовательский
        // ip в pic_state:4[0] перед переходом к обработчику.
        instruction irq-enter = { 0010 1000 } {
            irq_sp = sp;
            irq_bp = bp;
            irq_dbp = dbp;
            irq_csp = csp;
            sp = ksp;
            bp = kbp;
            dbp = kdbp;
            csp = kcsp;
            ip = ip + 1;
        };

        // Настройка SimpleClock CyclesSignalPeriod значением с вершины стека.
        instruction set-period = { 0010 1001 } {
            sp = sp - 4;
            let period = stack_mem:4[sp];
            if period == 0 then {
                clock_state:4[64] = 0;
                pic_state:4[20] = 0;
            }
            else {
                let cycles = clock_state:4[48];
                clock_state:4[64] = cycles + period;
            }
            clock_state:4[68] = 0;
            ip = ip + 1;
        };

        // Установка обработчика для прерывания PIC в pic_handlers[slot*4].
        // Адрес кода обработчика передаётся непосредственным операндом.
        instruction set-cycles-handler = { 0010 1010, code32 as handler } {
            pic_state:4[8] = 4;
            pic_state:4[16] = 1;
            pic_handlers:4[8] = handler;
            ip = ip + 5;
        };

        // Байтовая адресация, используемая при инспектировании Btrfs-образа в SPO8.
        instruction index-byte-op = { 0010 1011 } {
            sp = sp - 4;
            let idx = stack_mem:4[sp];
            sp = sp - 4;
            let base = stack_mem:4[sp];
            let addr = base + idx;
            stack_mem:4[sp] = addr;
            sp = sp + 4;
            ip = ip + 1;
        };

        instruction load-byte-ind = { 0010 1100 } {
            sp = sp - 4;
            let addr = stack_mem:4[sp];
            let value = data_mem:1[addr];
            stack_mem:4[sp] = value;
            sp = sp + 4;
            ip = ip + 1;
        };

        instruction store-byte-ind = { 0010 1101 } {
            sp = sp - 4;
            let value = stack_mem:4[sp];
            sp = sp - 4;
            let addr = stack_mem:4[sp];
            data_mem:1[addr] = value;
            ip = ip + 1;
        };

        // Синхронные приём и отправка байта через SimplePipe.
        // По vm-devices.pdf control[8] — SyncReceive, control[0] — SyncSend.
        instruction pipe-in-op = { 0010 1110 } {
            let value = pipe_control:1[8];
            stack_mem:4[sp] = value;
            sp = sp + 4;
            ip = ip + 1;
        };

        instruction pipe-out-op = { 0010 1111 } {
            sp = sp - 4;
            let value = stack_mem:4[sp];
            pipe_control:1[0] = value;
            ip = ip + 1;
        };

        instruction data-out-op = { 0011 0010 } {
            sp = sp - 4;
            let value = stack_mem:4[sp];
            data_pipe_control:1[0] = value;
            ip = ip + 1;
        };

        instruction data-buf-byte-op = { 0011 0011 } {
            sp = sp - 4;
            let value = stack_mem:4[sp];
            sp = sp - 4;
            let dataOffset = stack_mem:4[sp];
            data_pipe_outbox:1[dataOffset] = value;
            ip = ip + 1;
        };

        instruction data-flush-op = { 0011 0100 } {
            sp = sp - 4;
            let length = stack_mem:4[sp];
            if length > 0 then {
                data_pipe_control:4[24] = 0;
                data_pipe_control:4[28] = length;
                data_pipe_control:1[56] = 0;
                data_pipe_control:1[60] = 1;
            }
            ip = ip + 1;
        };

        // Синхронные чтение и запись одного байта через BlockDevice. В ABI устройства
        // позиция 64-битная; SPO8 использует младшие 32 бита и обнуляет старшую половину.
        instruction block-read-byte-op = { 0011 0000 } {
            sp = sp - 4;
            let position = stack_mem:4[sp];
            block_control:4[0] = position;
            block_control:4[4] = 0;
            block_control:4[8] = 1;
            block_control:1[16] = 0;
            block_control:1[20] = 1;
            let value = block_buffer:1[0];
            stack_mem:4[sp] = value;
            sp = sp + 4;
            ip = ip + 1;
        };

        instruction block-write-byte-op = { 0011 0001 } {
            sp = sp - 4;
            let value = stack_mem:4[sp];
            sp = sp - 4;
            let position = stack_mem:4[sp];
            block_buffer:1[0] = value;
            block_control:4[0] = position;
            block_control:4[4] = 0;
            block_control:4[8] = 1;
            block_control:1[16] = 0;
            block_control:1[24] = 1;
            ip = ip + 1;
        };

        // Чтение диапазона в буфер BlockDevice. Это стандартный режим
        // BackDevice/read из vm-devices.pdf: Position + Length + Reading.
        instruction block-read-buf-op = { 0011 0101 } {
            sp = sp - 4;
            let length = stack_mem:4[sp];
            sp = sp - 4;
            let position = stack_mem:4[sp];
            block_control:4[0] = position;
            block_control:4[4] = 0;
            block_control:4[8] = length;
            block_control:1[16] = 0;
            block_control:1[20] = 1;
            ip = ip + 1;
        };

        // Получение одного байта из буфера, заполненного block-read-buf-op.
        instruction block-buf-byte-op = { 0011 0110 } {
            sp = sp - 4;
            let bufIndex = stack_mem:4[sp];
            let value = block_buffer:1[bufIndex];
            stack_mem:4[sp] = value;
            sp = sp + 4;
            ip = ip + 1;
        };

        // Быстрое копирование уже прочитанного диапазона BlockDevice в
        // outbox пассивного SimplePipe. Так RETR не тратит одну VM-команду
        // на каждый байт файла: потоковая семантика остаётся, но пересылка
        // выполняется порцией BackDevice/read -> FSPipe/write.
        instruction data-copy-block-op = { 0011 0111 } {
            sp = sp - 4;
            let length = stack_mem:4[sp];
            let copyIndex = 0;
            while copyIndex < length do {
                data_pipe_outbox:1[copyIndex] = block_buffer:1[copyIndex];
                copyIndex = copyIndex + 1;
            }
            if length > 0 then {
                data_pipe_control:4[24] = 0;
                data_pipe_control:4[28] = length;
                data_pipe_control:1[56] = 0;
                data_pipe_control:1[60] = 1;
            }
            ip = ip + 1;
        };


    mnemonics:

        mnemonic nop () "";

        mnemonic push_const for push-const (const_id) "{1}";
        mnemonic push_addr for push-addr (addr) "{1}";
        mnemonic push_code for push-code (target) "{1}";
        mnemonic load for load (addr) "{1}";
        mnemonic store for store (addr) "{1}";
        mnemonic load_ind for load-ind () "";
        mnemonic store_ind for store-ind () "";
        mnemonic pop () "";

        mnemonic add for add () "";
        mnemonic sub for sub () "";
        mnemonic mul for mul () "";
        mnemonic div for div () "";
        mnemonic rem for rem () "";
        mnemonic neg for neg () "";
        mnemonic and_op for and-op () "";
        mnemonic or_op for or-op () "";
        mnemonic lt for lt () "";
        mnemonic gt for gt () "";
        mnemonic le for le () "";
        mnemonic ge for ge () "";
        mnemonic eq for eq () "";
        mnemonic ne for ne () "";

        mnemonic jmp for jmp (target) "{1}";
        mnemonic jz for jz (target) "{1}";
        mnemonic call for call (target, argc) "{1}, {2}";
        mnemonic ret for ret () "";
        mnemonic retf for retf () "";
        mnemonic enter for enter (nlocals) "{1}";
        mnemonic leave for leave () "";

        mnemonic range_op for range-op () "";
        mnemonic index for index-op () "";

        mnemonic set_port for set-port () "";
        mnemonic in for in-op () "";
        mnemonic out for out-op () "";
        mnemonic push_sys for push-sys (sys_id) "{1}";
        mnemonic pop_sys for pop-sys (sys_id) "{1}";
        mnemonic ei for ei-op () "";
        mnemonic di for di-op () "";
        mnemonic iret for iret-op () "";
        mnemonic irq_enter for irq-enter () "";
        mnemonic set_period for set-period () "";
        mnemonic set_cycles_handler for set-cycles-handler (handler) "{1}";
        mnemonic indexb for index-byte-op () "";
        mnemonic loadb_ind for load-byte-ind () "";
        mnemonic storeb_ind for store-byte-ind () "";
        mnemonic pipe_in for pipe-in-op () "";
        mnemonic pipe_out for pipe-out-op () "";
        mnemonic block_read_byte for block-read-byte-op () "";
        mnemonic block_write_byte for block-write-byte-op () "";
        mnemonic data_out for data-out-op () "";
        mnemonic data_buf_byte for data-buf-byte-op () "";
        mnemonic data_flush for data-flush-op () "";
        mnemonic block_read_buf for block-read-buf-op () "";
        mnemonic block_buf_byte for block-buf-byte-op () "";
        mnemonic data_copy_block for data-copy-block-op () "";

}
