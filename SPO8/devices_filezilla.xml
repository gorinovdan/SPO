<?xml version="1.0" encoding="utf-8"?>
<VmDevicesConfiguration xmlns="Portable.TargetPlatform.Vm.Devices">
  <DeviceType Name="SimplePic" Id="1" />
  <DeviceType Name="SimpleClock" Id="2" />
  <DeviceType Name="SimplePipe" Id="3" />
  <DeviceType Name="BlockDevice" Id="4" />

  <Device DeviceType="SimplePic" Name="pic" Id="1">
    <IoPortMap PortType="state" Id="0" BankName="pic_state" Mode="RAM">
      <InitialBinding StartAddress="0x0" Length="0x30" />
    </IoPortMap>
    <IoPortMap PortType="handlers-map" Id="1" BankName="pic_handlers" Mode="RAM">
      <InitialBinding StartAddress="0x0" Length="0x40" />
    </IoPortMap>
    <Parameter Name="HandlersTableEntrySize" Value="4" />
  </Device>

  <Device DeviceType="SimpleClock" Name="clock" Id="2">
    <IoPortMap PortType="state" Id="0" BankName="clock_state" Mode="RAM">
      <InitialBinding StartAddress="0x0" Length="0x48" />
    </IoPortMap>
    <Signal Name="on-ticks" Id="1" Interrupt="1" />
    <Signal Name="on-cycles" Id="2" Interrupt="2" />
  </Device>

  <!-- Управляющее FTP-соединение: VM подключается к локальному адаптеру
       на 127.0.0.1:3121. FileZilla подключается к внешнему порту адаптера
       127.0.0.1:2121. Так RemoteTasks получает один последовательный
       control-поток, а FileZilla может открывать повторные control-соединения. -->
  <Device DeviceType="SimplePipe" Name="ftp-control" Id="3">
    <IoPortMap PortType="control" Id="0" BankName="pipe_control" Mode="RAM">
      <InitialBinding StartAddress="0x0" Length="0x48" />
    </IoPortMap>
    <IoPortMap PortType="inbox" Id="1" BankName="pipe_inbox" Mode="RAM">
      <InitialBinding StartAddress="0x0" Length="0x800" />
    </IoPortMap>
    <IoPortMap PortType="outbox" Id="2" BankName="pipe_outbox" Mode="RAM">
      <InitialBinding StartAddress="0x0" Length="0x800" />
    </IoPortMap>
    <Parameter Name="PipeSpec" Value="tcp://127.0.0.1:3121" />
    <Parameter Name="OperationMode" Value="ByteStream" />
  </Device>

  <!-- Пассивный FTP-поток данных. VM подключается к тому же локальному
       FTP-адаптеру на порту 3020; FileZilla подключается к пассивному
       FTP-порту 2020, который возвращает команда PASV. Адаптер закрывает
       сокеты отдельных передач: это не источник Btrfs-данных. -->
  <Device DeviceType="SimplePipe" Name="ftp-data" Id="5">
    <IoPortMap PortType="control" Id="0" BankName="data_pipe_control" Mode="RAM">
      <InitialBinding StartAddress="0x0" Length="0x48" />
    </IoPortMap>
    <IoPortMap PortType="inbox" Id="1" BankName="data_pipe_inbox" Mode="RAM">
      <InitialBinding StartAddress="0x0" Length="0x800" />
    </IoPortMap>
    <IoPortMap PortType="outbox" Id="2" BankName="data_pipe_outbox" Mode="RAM">
      <InitialBinding StartAddress="0x0" Length="0x800" />
    </IoPortMap>
    <Parameter Name="PipeSpec" Value="tcp://127.0.0.1:3020" />
    <Parameter Name="OperationMode" Value="ByteStream" />
  </Device>

  <!-- Блочный BackDevice с настоящим образом каталога SPO8. -->
  <Device DeviceType="BlockDevice" Name="btrfs-image" Id="4">
    <IoPortMap PortType="control" Id="0" BankName="block_control" Mode="RAM">
      <InitialBinding StartAddress="0x0" Length="0x24" />
    </IoPortMap>
    <IoPortMap PortType="buffer" Id="1" BankName="block_buffer" Mode="RAM">
      <InitialBinding StartAddress="0x0" Length="0x1000" />
    </IoPortMap>
    <IoPortMap PortType="error" Id="2" BankName="block_error" Mode="RAM">
      <InitialBinding StartAddress="0x0" Length="0x400" />
    </IoPortMap>
    <Parameter Name="FileName" Value="spo8_btrfs_block.img" />
    <Parameter Name="InteractiveFileMode" Value="OpenOrCreate" />
  </Device>
</VmDevicesConfiguration>
