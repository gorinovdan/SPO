Grammar

    0 $accept: source $end

    1 source: source_item_set

    2 source_item: func_def
    3            | type_def
    4            | interface_def

    5 source_item_set: source_item
    6                | source_item_set source_item

    7 func_def: DEF func_signature statement_set END
    8         | DEF func_signature END

    9 type_def: TYPE_KW identifier type_member_set END
   10         | TYPE_KW identifier EXTENDS identifier type_member_set END
   11         | TYPE_KW identifier IMPLEMENTS interface_name_list type_member_set END
   12         | TYPE_KW identifier EXTENDS identifier IMPLEMENTS interface_name_list type_member_set END
   13         | TYPE_KW identifier END
   14         | TYPE_KW identifier EXTENDS identifier END
   15         | TYPE_KW identifier IMPLEMENTS interface_name_list END
   16         | TYPE_KW identifier EXTENDS identifier IMPLEMENTS interface_name_list END

   17 interface_def: INTERFACE identifier interface_member_set END
   18              | INTERFACE identifier END

   19 interface_name_list: identifier
   20                    | interface_name_list ',' identifier

   21 type_member_set: type_member
   22                | type_member_set type_member

   23 type_member: field_def
   24            | method_def

   25 field_def: identifier OF type_ref ';'

   26 method_def: func_def
   27           | OVERRIDE func_def

   28 interface_member_set: interface_member
   29                     | interface_member_set interface_member

   30 interface_member: DEF func_signature ';'

   31 statement: selection_statement
   32          | iteration_statement
   33          | BREAK ';'
   34          | assignment_expr ';'
   35          | var_decl
   36          | block_statement

   37 var_decl: identifier OF type_ref ';'
   38         | identifier OF type_ref '=' assignment_expr ';'

   39 statement_set: statement
   40              | statement_set statement

   41 in_block_set: statement
   42             | func_def
   43             | in_block_set statement
   44             | in_block_set func_def

   45 selection_statement: IF assignment_expr THEN statement ELSE statement
   46                    | IF assignment_expr THEN statement

   47 iteration_statement: WHILE assignment_expr statement_set END
   48                    | WHILE assignment_expr END
   49                    | UNTIL assignment_expr statement_set END
   50                    | UNTIL assignment_expr END
   51                    | statement WHILE assignment_expr ';'
   52                    | statement UNTIL assignment_expr ';'

   53 block_statement: BEGIN_T in_block_set END
   54                | BEGIN_T in_block_set '}'
   55                | '{' in_block_set END
   56                | '{' in_block_set '}'
   57                | BEGIN_T END
   58                | BEGIN_T '}'
   59                | '{' END
   60                | '{' '}'

   61 slice_range: assignment_expr
   62            | assignment_expr '.' '.' assignment_expr

   63 slice_range_list: slice_range
   64                 | slice_range_list ',' slice_range

   65 primary_expr: identifier
   66             | literal
   67             | '(' assignment_expr ')'

   68 postfix_expr: primary_expr
   69             | postfix_expr EMPTY_BRACKETS
   70             | postfix_expr '(' argument_expr_list ')'
   71             | postfix_expr '[' slice_range_list ']'
   72             | postfix_expr '.' identifier

   73 argument_expr_list: assignment_expr
   74                   | argument_expr_list ',' assignment_expr

   75 unary_expr: postfix_expr
   76           | unary_operator unary_expr

   77 multiplicative_expr: unary_expr
   78                    | multiplicative_expr '*' unary_expr
   79                    | multiplicative_expr '/' unary_expr
   80                    | multiplicative_expr '%' unary_expr

   81 additive_expr: multiplicative_expr
   82              | additive_expr '+' multiplicative_expr
   83              | additive_expr '-' multiplicative_expr

   84 relational_expr: additive_expr
   85                | relational_expr '<' additive_expr
   86                | relational_expr '>' additive_expr
   87                | relational_expr LE_OP additive_expr
   88                | relational_expr GE_OP additive_expr

   89 equality_expr: relational_expr
   90              | equality_expr EQ_OP relational_expr
   91              | equality_expr NE_OP relational_expr

   92 logical_and_expr: equality_expr
   93                 | logical_and_expr AND_OP equality_expr

   94 logical_or_expr: logical_and_expr
   95                | logical_or_expr OR_OP logical_and_expr

   96 assignment_expr: logical_or_expr
   97                | postfix_expr assignment_operator assignment_expr

   98 assignment_operator: '='

   99 unary_operator: UMINUS

  100 literal: BOOL_VAL
  101        | STRING_VAL
  102        | CHAR_VAL
  103        | HEX_VAL
  104        | BITS_VAL
  105        | DEC_VAL

  106 func_signature: identifier '(' arg_def_list ')'
  107               | identifier EMPTY_BRACKETS
  108               | identifier '(' arg_def_list ')' OF type_ref
  109               | identifier EMPTY_BRACKETS OF type_ref

  110 arg_def_list: arg_def
  111             | arg_def_list ',' arg_def

  112 arg_def: identifier
  113        | identifier OF type_ref

  114 type_ref: builtin
  115         | identifier
  116         | array

  117 array: builtin ARRAY '[' DEC_VAL ']'
  118      | identifier ARRAY '[' DEC_VAL ']'

  119 builtin: BOOL
  120        | BYTE
  121        | INT
  122        | UINT
  123        | LONG
  124        | ULONG
  125        | CHAR
  126        | STRING

  127 identifier: IDENTIFIER


