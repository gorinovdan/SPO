Grammar

    0 $accept: source $end

    1 source: source_item_set

    2 source_item: func_def

    3 source_item_set: source_item
    4                | source_item_set source_item

    5 func_def: DEF func_signature statement_set END
    6         | DEF func_signature END

    7 statement: selection_statement
    8          | iteration_statement
    9          | BREAK ';'
   10          | assignment_expr ';'
   11          | block_statement

   12 statement_set: statement
   13              | statement_set statement

   14 in_block_set: statement
   15             | source_item
   16             | in_block_set statement
   17             | in_block_set source_item

   18 selection_statement: IF assignment_expr THEN statement ELSE statement
   19                    | IF assignment_expr THEN statement

   20 iteration_statement: WHILE assignment_expr statement_set END
   21                    | WHILE assignment_expr END
   22                    | UNTIL assignment_expr statement_set END
   23                    | UNTIL assignment_expr END
   24                    | statement WHILE assignment_expr ';'
   25                    | statement UNTIL assignment_expr ';'

   26 block_statement: BEGIN_T in_block_set END
   27                | BEGIN_T in_block_set '}'
   28                | '{' in_block_set END
   29                | '{' in_block_set '}'
   30                | BEGIN_T END
   31                | BEGIN_T '}'
   32                | '{' END
   33                | '{' '}'

   34 slice_range: assignment_expr
   35            | assignment_expr '.' '.' assignment_expr

   36 slice_range_list: slice_range
   37                 | slice_range_list ',' slice_range

   38 primary_expr: identifier
   39             | literal
   40             | '(' assignment_expr ')'

   41 postfix_expr: primary_expr
   42             | postfix_expr EMPTY_BRACKETS
   43             | postfix_expr '(' argument_expr_list ')'
   44             | postfix_expr '[' slice_range_list ']'

   45 argument_expr_list: assignment_expr
   46                   | argument_expr_list ',' assignment_expr

   47 unary_expr: postfix_expr
   48           | unary_operator unary_expr

   49 multiplicative_expr: unary_expr
   50                    | multiplicative_expr '*' unary_expr
   51                    | multiplicative_expr '/' unary_expr
   52                    | multiplicative_expr '%' unary_expr

   53 additive_expr: multiplicative_expr
   54              | additive_expr '+' multiplicative_expr
   55              | additive_expr '-' multiplicative_expr

   56 relational_expr: additive_expr
   57                | relational_expr '<' additive_expr
   58                | relational_expr '>' additive_expr
   59                | relational_expr LE_OP additive_expr
   60                | relational_expr GE_OP additive_expr

   61 equality_expr: relational_expr
   62              | equality_expr EQ_OP relational_expr
   63              | equality_expr NE_OP relational_expr

   64 logical_and_expr: equality_expr
   65                 | logical_and_expr AND_OP equality_expr

   66 logical_or_expr: logical_and_expr
   67                | logical_or_expr OR_OP logical_and_expr

   68 assignment_expr: logical_or_expr
   69                | postfix_expr assignment_operator assignment_expr

   70 assignment_operator: '='

   71 unary_operator: UMINUS

   72 literal: BOOL_VAL
   73        | STRING_VAL
   74        | CHAR_VAL
   75        | HEX_VAL
   76        | BITS_VAL
   77        | DEC_VAL

   78 func_signature: identifier '(' arg_def_list ')'
   79               | identifier EMPTY_BRACKETS
   80               | identifier '(' arg_def_list ')' OF type_ref
   81               | identifier EMPTY_BRACKETS OF type_ref

   82 arg_def_list: arg_def
   83             | arg_def_list ',' arg_def

   84 arg_def: identifier
   85        | identifier OF type_ref

   86 type_ref: builtin
   87         | identifier
   88         | array

   89 array: builtin ARRAY '[' DEC_VAL ']'
   90      | identifier ARRAY '[' DEC_VAL ']'

   91 builtin: BOOL
   92        | BYTE
   93        | INT
   94        | UINT
   95        | LONG
   96        | ULONG
   97        | CHAR
   98        | STRING

   99 identifier: IDENTIFIER


