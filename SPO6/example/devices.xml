<?xml version="1.0" encoding="utf-8"?>
<VmDevicesConfiguration xmlns="Portable.TargetPlatform.Vm.Devices">
  <DeviceType Name="SimplePic" Id="1" />
  <DeviceType Name="SimpleClock" Id="2" />
  <DeviceType Name="SimplePipe" Id="3" />

  <Device DeviceType="SimplePic" Name="pic" Id="1">
    <IoPortMap PortType="state" Id="0" BankName="codeDataMem" Mode="RAM">
      <InitialBinding StartAddress="0x10000" Length="0x30" />
    </IoPortMap>
    <IoPortMap PortType="handlers-map" Id="1" BankName="codeDataMem" Mode="RAM">
      <InitialBinding StartAddress="0x10100" Length="0x80" />
    </IoPortMap>
    <Parameter Name="HandlersTableEntrySize" Value="8" />
  </Device>

  <Device DeviceType="SimpleClock" Name="clock" Id="2">
    <IoPortMap PortType="state" Id="0" BankName="codeDataMem" Mode="RAM">
      <InitialBinding StartAddress="0x11000" Length="0x48" />
    </IoPortMap>
    <Signal Name="on-ticks" Id="1" Interrupt="1" />
    <Signal Name="on-cycles" Id="2" Interrupt="2" />
  </Device>

  <Device DeviceType="SimplePipe" Name="stdio" Id="3">
    <IoPortMap PortType="control" Id="0" BankName="codeDataMem" Mode="RAM">
      <InitialBinding StartAddress="0x12000" Length="0x48" />
    </IoPortMap>

    <IoPortMap PortType="inbox" Id="1" BankName="codeDataMem" Mode="RAM">
      <InitialBinding StartAddress="0x14000" Length="0x800" />
    </IoPortMap>

    <IoPortMap PortType="outbox" Id="2" BankName="codeDataMem" Mode="RAM">
      <InitialBinding StartAddress="0x15000" Length="0x800" />
    </IoPortMap>

    <Parameter Name="PipeSpec" Value="stdio" />
  </Device>
</VmDevicesConfiguration>
